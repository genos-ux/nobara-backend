DATABASE_URL=postgresql://user:password@localhost:5432/nabora_crm

# JWT settings
SECRET_KEY=your-super-secret-jwt-key-change-in-production
REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Required: encrypts sensitive database fields at rest.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up securely. Losing it makes encrypted data unrecoverable.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=new_password

# Email (Brevo HTTP API — no SMTP, works on Render)
EMAIL_FROM=noreply@yourdomain.com
BREVO_API_KEY=your-brevo-api-key

# Frontend URL (used in invitation links; always allowed by CORS)
FRONTEND_URL=http://localhost:3000

# Extra allowed browser origins (comma-separated). FRONTEND_URL is always allowed.
CORS_ORIGINS=http://localhost:3000

# Password reset token expiry (minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
